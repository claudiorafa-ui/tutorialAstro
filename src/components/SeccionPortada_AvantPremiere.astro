---
const textColor = "#fdd3bc";
const backgroundColorTop = "#fdd3bc";
const backgroundColorBottom = "#0a0a0a";

import chatNoir from "../images/ChatNoir2.png";

import Button from "./Button.astro";
---

<section
  id="avant-premiere"
  class="text-[#fdd3bc]
         bg-[#444444] 
         py-20
         sm:py-28
         overflow-hidden"
>

  <!-- Grid de 5 columnas -->
  <div
    class="grid
           grid-cols-1
           w-5/6
           mx-auto
           border-0
           rounded-2xl
           gap-10
           
           md:grid-cols-2"
  > 
    <!-- Imagen de Chat-noir -->
    <div class="col-span-1
            shadow-xl/40
            rounded-2xl
            relative
            overflow-hidden
            border-2
            border-[#fdd3bc]
            aspect-[1/1]">
      <img
            src={chatNoir.src}
            alt="ChatNoir"
            class="
                  inset-0
                  w-full
                  h-full
                  object-cover"
          />
        <!-- texto sobre imagen -->
        <div class="absolute
                    bottom-0
                    left-0
                    w-full
                    rounded-b-2xl
                    md:p-6
                    ">
          <p class="text-base
                     font-serif
                     uppercase
                     tracking-tight
                     text-center
                     text-white
                     mb-6
                     md:text-2xl">
            Viernes 6 de noviembre de 2026 <br />
            18:00 a 22:00 hrs. <br />
            Chat Noir, La Dehesa <br />
          </p>
        </div>
          
    </div>

    <!-- Descripción del avant premiere -->
    <div class="col-span-1
                flex
                flex-col
                justify-between
                items-start
                p-6
                z-10">
      <h1 class="mt-10
                 text-4xl
                 
                 font-serif
                 md:text-6xl">
        Avant Premiére
      </h1>
      <h2 class="text-2xl
                 
                 font-serif
                 mb-4
                 md:text-3xl">
        Una experiencia sensorial
      </h2>
      <p class="my-3
               text-xl
               leading-relaxed
               font-serif

               md:text-2xl">
        Disfruta una degustación a ciegas de cócteles inspirados en materias 
        primas de la perfumería, creada por el bartender Carlos Ramírez junto 
        al Laboratorio Alquímico de Aromas y Destilación.          
      </p>
      <p class="mt-6
                font-serif
                text-base
                leading-relaxed">
               <strong>NUESTRAS MARCAS: </strong><br />
               <br />
               Barum Parfum · Loris Parfum · Parfumeurs du Monde · Pure Signature · Roussar Parfum · 
              Gabriel De Carvalho · Federico Kukso · Atelier Galimard & Giolor Perfumes
      </p>
      <!-- Botón -->
      <div class="w-full
                  mx-auto
                  mt-10
                  border-0
                  flex
                  ">
        <Button
          title="ENTRADAS"
          height="40px"
          textColor="#fdd3bc"
          backgroundColor="#0a0a0a"
          border="none"
          href="/aromasfest"
        />
      </div>
    </div>

    
    

  </div>

</section>