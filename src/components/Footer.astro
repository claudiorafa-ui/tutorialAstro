---
import logoAromasFestVertical from "../images/AromasFest-Logo-Simple.svg";

const textColor = "#fdd3bc";
---

<footer
  class="relative
         overflow-hidden
         bg-black
         font-serif"
  style={`color: ${textColor};`}
>
  <div class="relative z-10 w-5/6 mx-auto py-16">

    <!-- Contenido principal -->
    <div
      class="flex
             flex-col
             gap-12
             
             md:grid
             md:grid-cols-3
             md:items-center"
    >
      <!-- Festival -->
      <div
        class="flex
               flex-col
               gap-3
               text-center
               
               md:text-end"
      >
        <h2 class="text-4xl">
          AromasFest
        </h2>

        <p class="text-base
                leading-relaxed
                opacity-70

                md:text-xl">
          El primer festival del perfume en Chile.
        </p>

        <p class="text-sm 
                  opacity-70
                  md:text-base">
          Aromas, creatividad y personas.
        </p>
      </div>

      <!-- Logo -->
      <div
        class="flex
               justify-center
               "
      >
        <img
          src={logoAromasFestVertical.src}
          alt="AromasFest"
          class="h-auto
                 w-32
                 object-contain
                 
                 md:w-36"
        />
      </div>


      <!-- Navegación -->
      <nav
        class="flex
               flex-col
               gap-3
               text-center
               text-2xl
               
               md:items-start
               "
        aria-label="Navegación del sitio"
      >
        <a
          href="#inicio"
          class="
          transition-opacity 
          hover:opacity-60"
        >
          Inicio
        </a>

        <a
          href="#avant-premiere"
          class="transition-opacity hover:opacity-60"
        >
          Avant Première
        </a>

        <a
          href="#iii_festival"
          class="transition-opacity hover:opacity-60"
        >
          IIIer Festival
        </a>

        
      </nav>

    </div>

    <!-- Separador -->
    <div class="my-10 h-px bg-white/20"></div>

    <!-- Pie inferior -->
    <div
      class="flex
             flex-col
             gap-3
             text-center
             text-xs
             opacity-60
             
             md:flex-row
             md:items-center
             md:justify-between
             md:text-left"
    >
      <p>
        © 2026 AromasFest
      </p>

      <p>
        Creado por AromasFest
      </p>

      <a
        href="https://www.instagram.com/aromasfest/?hl=es"
        class="transition-opacity hover:opacity-100"
      >
        Instagram
      </a>
    </div>

  </div>
</footer>