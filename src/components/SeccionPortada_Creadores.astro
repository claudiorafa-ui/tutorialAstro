---
import Button from "./Button.astro";
import Card_Creadores from "./Card_Creadores.astro";

import imagenAromasFest from "../images/background_c.jpg";

const textColor = "#fdd3bc";
const backgroundColor = "#0a0a0a";

const cardsCreadores = [
  { title: "Karen", image: imagenAromasFest.src},
  { title: "Giovanna", image: imagenAromasFest.src},
  { title: "Natalia", image: imagenAromasFest.src},
  { title: "Dominique", image: imagenAromasFest.src},
  { title: "Claudia", image: imagenAromasFest.src},
  { title: "Creador 06", image: imagenAromasFest.src},
  { title: "Creador 07", image: imagenAromasFest.src},
  { title: "Creador 08", image: imagenAromasFest.src},
  { title: "Creador 09", image: imagenAromasFest.src},
  { title: "Creador 10", image: imagenAromasFest.src},
  { title: "Creador 11", image: imagenAromasFest.src},
  { title: "Creador 12", image: imagenAromasFest.src},
];
---

<section
  class="text-[#fdd3bc] 
          bg-[#0a0a0a] 
          py-20 sm:py-28 
          overflow-hidden"
  style={`color: ${textColor}; background-color: ${backgroundColor};`}
>
  <div class=" w-full">

    <!-- Grid de 2 columnas -->
    <div
      class="w-5/6
            mx-auto
            items-end
            grid
            grid-cols-2
            gap-6

            md:grid-cols-5">

      <!-- TEXTO: 3 de 5 columnas -->
      <div
        class="col-span-2
               flex
               flex-col
               justify-between
               py-6
               
               md:col-span-3"
      >

        <!-- Título -->
        <h2
          class="font-serif
                 font-bold
                 uppercase
                 text-5xl                 
                 tracking-tight
                 text-start

                 md:text-8xl"
        >
          <span class="relative block">
            Nuestros  <br />
            Creadores
          </span>
        </h2>

      </div>
      {
          cardsCreadores.map((card) => (
                                        <Card_Creadores
                                        image={card.image}
                                        title={card.title}
                                        />
                                        ))
      }
    </div>
    <!-- Botón -->
    <div class="w-5/6
                mx-auto
                border-0
                ">
      <div class="flex 
                  justify-end
                  mt-6">
        <Button
          title="Más creadores"
          height="40px"
          textColor="#0a0a0a"
          backgroundColor="#fdd3bc"
          border="none"
          href="/aromasfest"
        />
      </div>
    </div>

    

   

  </div>
</section>