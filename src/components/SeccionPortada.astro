---
import background from "../images/background_c.jpg";
import backgroundMobile from "../images/background_mobile.jpg";
import Button from "./Button.astro";
import logoAromasFestVertical from "../images/logo_AromasFest_Vertical.svg";

const textColor = "#fdd3bc";
---

<main
  class="relative min-h-screen overflow-hidden font-serif bg-black"
  style={`color: ${textColor};`}
>

  <!-- Background -->
  <div class="absolute inset-0">

    <picture>
      <source
        media="(max-width: 768px)"
        srcset={backgroundMobile.src}
      />

      <img
        src={background.src}
        alt="Logo AromasFest"
        class="h-full w-full object-cover"
      />
    </picture>

  </div>

  <!-- Contenido de la portada -->
  <div class="relative z-10 min-h-screen">

    <!-- Grilla principal -->
    <section
      id="inicio"
      class="mx-auto
             flex
             flex-col
             gap-10
             min-h-screen
             py-24
             w-5/6

             md:grid
             md:grid-cols-12
             md:py-0
             md:w-5/6"
    >

      <!-- Columna Logo AromasFest -->
      <div
        class="order-1
               flex
               items-center
               justify-center
               py-8

               md:order-2
               md:col-span-4
               md:mt-20"
      >
        <img
          src={logoAromasFestVertical.src}
          alt="Logo AromasFest"
          class="h-auto
                 max-h-[55vh]
                 w-3/4
                 object-contain

                 lg:h-5/6
                 lg:w-auto"
        />
      </div>


      <!-- Columna Avant Première -->
      <div
        class="order-2
                w-full
                max-w-[400px]
                mx-auto
                px-4
                py-4
                border-2
                border-[#fdd3bc]
                rounded-xl
                bg-black/50

                flex
                flex-row
                gap-10
                justify-between
                items-stretch

                md:order-1
                md:col-span-4
                md:flex-col
                md:justify-center
                md:max-w-none
                md:mx-0
                md:border-0
                md:bg-transparent
                md:mt-20">

        <!-- Título + botón -->
        <div
          class="order-1
                 flex
                 flex-col
                 justify-between
                 gap-4"
        >

          <h1 class="text-4xl md:text-6xl lg:text-7xl">
            Avant <br />
            Première
          </h1>

          <div class="flex justify-start">
            <Button
              title="Entradas"
              height="30px"
              textColor="#fdd3bc"
              backgroundColor="rgba(255, 255, 255, 0.3)"
              border="none"
              href="https://www.passline.com/sitio-evento/avant-premiere-aromasfest"
            />
          </div>

        </div>


        <!-- Información Avant Première -->
        <div
          class="order-2
                 flex
                 flex-col
                 gap-4
                 justify-center
                 text-end

                 md:text-start"
        >

          <h1 class="text-1xl">
            Viernes<br />
            6 de Noviembre<br />
            18:00 - 22:00
          </h1>

          <h1 class="text-1xl">
            Malbec 12851<br />
            Chat Noir<br />
            La Dehesa
          </h1>

        </div>

      </div>


      <!-- Columna IIIa Versión -->
      <div
        class="order-3
                w-full
                max-w-[400px]
                mx-auto
                px-4
                py-4
                border-2
                border-[#fdd3bc]
                rounded-xl
                bg-black/50

                flex
                flex-row
                gap-10
                justify-between
                items-stretch

                md:order-3
                md:col-span-4
                md:flex-col
                md:justify-center
                md:max-w-none
                md:mx-0
                md:border-0
                md:bg-transparent
                md:mt-20">

        <!-- Información IIIa Versión -->
        <div
          class="order-2
                 flex
                 flex-col
                 gap-4
                 text-end

                 md:order-1"
        >

          <h1 class="text-1xl">
            Sábado<br />
            7 de Noviembre<br />
            11:00 - 21:00
          </h1>

          <h1 class="text-1xl">
            Malbec 12851<br />
            Hotel Wyndham Pettra<br />
            La Dehesa
          </h1>

        </div>


        <!-- Botón + título -->
        <div
          class="order-1
                 flex
                 flex-col
                 gap-4
                 text-end
                 justify-between

                 md:order-2"
        >

          <!-- Botón entradas -->
          <div
            class="order-2
                   flex
                   items-center
                   justify-start

                   md:justify-end"
          >
            <Button
              title="Entradas"
              height="30px"
              textColor="#fdd3bc"
              backgroundColor="rgba(255, 255, 255, 0.3)"
              border="none"
              href="https://www.passline.com/sitio-evento/iii-version-aromasfest-2026"
            />
          </div>


          <!-- Título IIIa Versión -->
          <h1
            class="order-1
                   text-4xl
                   text-start

                   md:text-6xl
                   md:order-2
                   md:text-end

                   lg:text-7xl"
          >
            IIIa<br />
            Versión
          </h1>

        </div>

      </div>

    </section>

  </div>

</main>
